# ============================================================
# VIIT CR ELECTIONS 2026 - PRODUCTION ENVIRONMENT CONFIGURATION
# Institution: Vignan's Institute of Information Technology
# Department: Department of Data Science
# Developed by: SkillForge Club
# ============================================================

# Server Port & Runtime Environment
PORT=3000
NODE_ENV=production
ELECTION_MODE=PRODUCTION

# ------------------------------------------------------------
# SUPABASE POSTGRESQL CLOUD DATABASE CONFIGURATION
# ------------------------------------------------------------
# Frontend Public Credentials (Safe for browser / client build)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-jwt
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Backend Authoritative Service Role Key (NEVER expose to browser or prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------
# SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------
# Generate strong, random 64-character strings for production JWT signatures
APP_SECRET=generate-a-strong-random-secret-key-for-student-session-tokens
ADMIN_AUTH_SECRET=generate-a-strong-random-secret-key-for-admin-session-tokens

# Student Authentication Mode: DIRECT_ROSTER | EMAIL_OTP | COLLEGE_OAUTH
STUDENT_AUTH_MODE=DIRECT_ROSTER

# ------------------------------------------------------------
# ADMIN DEFAULT CREDENTIALS (Initial Bootstrapping)
# ------------------------------------------------------------
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin@viit2026

# Optional: Google Apps Script Webhook URL (for real-time secondary backup sheet)
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=viit_apps_script_hmac_secret_2026
